# App
NODE_ENV=development
PORT=4100

# Backend (server-side only — never exposed to browser)
BACKEND_INTERNAL_URL=http://localhost:3100
BACKEND_API_SECRET=dev-backend-api-secret

# Cookie / session signing key. Reserved, not read: the backend seals the session
# cookie and this app only stores what it issues, so `config/env.schema.ts` is its
# only reference today. Local dev default, public in this repository — the schema
# refuses this exact string in staging/production so it cannot later become a live
# key still holding a published value.
# Generate a real one: openssl rand -base64 32
SESSION_SECRET=dev-session-secret-must-be-at-least-32-chars

# Binding token HMAC key — server-only, never exposed to browser. Unlike
# SESSION_SECRET this one is live (lib/auth/binding.ts), so a known value means
# forgeable binding tokens. Same local dev default and the same
# staging/production refusal.
# Generate for production: openssl rand -base64 32
BINDING_SECRET=dev-binding-secret-must-be-at-least-32-chars

# Public — safe to bundle into browser
NEXT_PUBLIC_APP_NAME=LL Stack

# Logging (server-side) — mirrors the backend's LOG_* knobs.
# LOG_SINK: stdout | http_otlp | seq (default stdout)
LOG_SINK=stdout
# LOG_LEVEL: trace|debug|info|warn|error|fatal (defaults per NODE_ENV)
# LOG_LEVEL=debug
# LOG_REMOTE=true ships server logs through the sink; off (default in dev) prints to terminal.
# LOG_REMOTE=false
# Seq (used when LOG_SINK=seq) — local Seq matches the backend (apps/backend/.env).
# SEQ_SERVER_URL=http://localhost:8087
# SEQ_API_KEY=
# LOG_HTTP_OTLP_ENDPOINT=
#
# To view frontend logs in local Seq, set:
#   LOG_REMOTE=true
#   LOG_SINK=seq
#   SEQ_SERVER_URL=http://localhost:8087

# Logging (browser) — NEXT_PUBLIC_* is bundled into the client.
# NEXT_PUBLIC_LOG_LEVEL=debug
# NEXT_PUBLIC_LOG_REMOTE=true ships browser logs to /api/client-logs; off (default in dev) is console-only.
# NEXT_PUBLIC_LOG_REMOTE=false

# DEV_MODE: enables frontend-only local development routes such as /dev.
DEV_MODE=true
