{
  "extends": "../../packages/config/tsconfig.nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "config/**/*.ts",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "instrumentation.ts",
    "instrumentation.test.ts",
    "proxy.ts",
    "proxy.test.ts",
    "next.config.ts",
    "vitest.config.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
