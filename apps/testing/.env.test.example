# Committed, non-secret test environment for the e2e harness.
# Consumed by playwright.config.ts and injected into the auto-booted webServer
# processes (backend + frontend). These values intentionally mirror the local
# dev defaults — they only ever target the disposable `llstack_test` database,
# never anything real.

# ── Shared ───────────────────────────────────────────────────────────────────
NODE_ENV=development

# Backend (NestJS, :3100) points at the disposable test database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/llstack_test
FRONTEND_PUBLIC_URL=http://localhost:4100
BACKEND_API_SECRET=dev-backend-api-secret
ADMIN_API_KEY=dev-admin-api-key
# The suite may drive many requests from one localhost IP, which would trip the
# per-IP throttles. Disable rate limiting for the run — the backend refuses
# this outside development/test (env.schema.ts).
RATE_LIMITING_ENABLED=false

# Frontend (Next.js, :4100) talks to the backend over the internal URL and
# seals its own browser-facing cookies with these dev signing secrets.
BACKEND_INTERNAL_URL=http://localhost:3100
SESSION_SECRET=dev-session-secret-must-be-at-least-32-chars
BINDING_SECRET=dev-binding-secret-must-be-at-least-32-chars
NEXT_PUBLIC_APP_NAME=LL Stack
