// Schema authored against `docs/charters/database-standards.md`.
// Agent contributors MUST read `docs/agents/database-standards.agents.md` before editing.
//
// Conventions enforced here and by `pnpm prisma:lint`:
//   - Named PKs (`<modelName>Id`) on UUID v7 with `@db.Uuid @map`
//   - UUID v7 generated at the service layer via `import { v7 as uuidv7 } from 'uuid'`; NO `@default(uuid())`
//   - All DateTime fields are `@db.Timestamptz(3)` with `@map`
//   - All columns mapped to snake_case via `@map`; all tables via `@@map`
//   - Archetype-correct timestamps (see charter timestamp reference table)
//   - Explicit `onDelete` on every relation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum UserRole {
  MEMBER
  ADMIN
}

// ─── Identity ───────────────────────────────────────────────────────────────

model User {
  userId       String    @id @map("user_id") @db.Uuid
  name         String    @map("name") @db.VarChar(120)
  // RAW CONSTRAINT: unique_active_user_email (see migration) — partial unique
  // index on email WHERE deleted_at IS NULL. Email is stored normalized
  // (trimmed + lowercased) at write time.
  email        String    @map("email") @db.VarChar(256)
  passwordHash String    @map("password_hash")
  // Which hashing scheme produced passwordHash (1 = argon2id with the current
  // parameters). Rehash-on-login dispatches on it — see database standards.
  hashVersion  Int       @default(1) @map("hash_version") @db.SmallInt
  // Terms/privacy consent captured at registration. The register DTO refuses
  // `false`, so every live row holds `true`; the column records that the
  // consent was given rather than being a branchable state.
  consent      Boolean   @map("consent")
  role         UserRole  @default(MEMBER) @map("role")
  // Soft-delete timestamp. A deleted account's passwordHash is replaced with
  // an unusable sentinel hash; this field records when.
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions Session[]

  @@index([role])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("users")
}

// Revocable server-side session. The raw bearer token is surfaced to the
// caller exactly once at issue time; only its SHA-256 hash is persisted.
// Archetype B (mutable, hard-delete only): rows mutate when revoked and are
// pruned outright when expired — never soft-deleted.
model Session {
  sessionId   String    @id @map("session_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  // Which hashing scheme produced tokenHash (1 = SHA-256 hex). See database
  // standards: every stored credential hash carries a version column.
  hashVersion Int       @default(1) @map("hash_version") @db.SmallInt
  issuedAt    DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}
