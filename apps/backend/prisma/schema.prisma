// Schema authored against `docs/charters/database-standards.md`.
// Agent contributors MUST read `docs/agents/database-standards.agents.md` before editing.
//
// Conventions enforced here and by `pnpm prisma:lint`:
//   - Named PKs (`<modelName>Id`) on UUID v7 with `@db.Uuid @map`
//   - UUID v7 generated at the service layer via `import { v7 as uuidv7 } from 'uuid'`; NO `@default(uuid())`
//   - All DateTime fields are `@db.Timestamptz(3)` with `@map`
//   - All columns mapped to snake_case via `@map`; all tables via `@@map`
//   - Archetype-correct timestamps (see charter timestamp reference table)
//   - Explicit `onDelete` on every relation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum UserRole {
  MEMBER
  ADMIN
}

// ─── Identity ───────────────────────────────────────────────────────────────

model User {
  userId       String    @id @map("user_id") @db.Uuid
  name         String    @map("name") @db.VarChar(120)
  // RAW CONSTRAINT: unique_active_user_email (see migration) — partial unique
  // index on email WHERE deleted_at IS NULL. Email is stored normalized
  // (trimmed + lowercased) at write time.
  email        String    @map("email") @db.VarChar(256)
  passwordHash String    @map("password_hash")
  // Which hashing scheme produced passwordHash (1 = argon2id). Rehash-on-login
  // dispatches on it: `AuthService.login` compares it against the current scheme
  // and, separately, asks argon2 whether the digest's embedded cost still
  // matches AUTH_ARGON2_*. Bump it when the SCHEME changes, not when the cost
  // does — see database standards.
  hashVersion  Int       @default(1) @map("hash_version") @db.SmallInt
  // Terms/privacy consent captured at registration. The register DTO refuses
  // `false`, so every live row holds `true`; the column records that the
  // consent was given rather than being a branchable state.
  consent      Boolean   @map("consent")
  role         UserRole  @default(MEMBER) @map("role")
  // Soft-delete timestamp. A deleted account's passwordHash is replaced with
  // an unusable sentinel hash; this field records when.
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions Session[]

  @@index([role])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("users")
}

// Revocable server-side session. The raw bearer token is surfaced to the
// caller exactly once at issue time; only its SHA-256 hash is persisted.
// Archetype B (mutable, hard-delete only): rows mutate when revoked or rotated
// and are pruned outright when expired — never soft-deleted.
//
// A row is one TOKEN, not one sign-in. Rotation supersedes a row and creates
// its successor in the same family, and every member of a family shares one
// expiresAt — rotation does not extend a session's life, so the family becomes
// prunable in a single sweep.
model Session {
  sessionId   String    @id @map("session_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  // Lineage key shared by every token one sign-in has held. A session that
  // starts a family carries its own sessionId here; a rotation copies it to the
  // successor. Deliberately not a self-relation: rows are pruned once expired,
  // and an FK would tie the family's lifetime to whichever member was pruned
  // first.
  familyId    String    @map("family_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  // Which hashing scheme produced tokenHash (1 = SHA-256 hex). Written and not
  // yet read: a token is presented raw on every request, so a second scheme
  // would be migrated on presentation rather than at a login, and there is no
  // second scheme. See database standards — every stored credential hash carries
  // a version column.
  hashVersion Int       @default(1) @map("hash_version") @db.SmallInt
  issuedAt    DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  // When this token was superseded by a rotation. Null means it is the family's
  // current token. A superseded token stays usable for
  // AUTH_SESSION_ROTATION_GRACE_SECONDS so an in-flight request that raced the
  // rotation still resolves; presenting one after that is something only a copy
  // can do, and it revokes the whole family.
  rotatedAt   DateTime? @map("rotated_at") @db.Timestamptz(3)
  // When this token was first presented on a request. Null means it was minted
  // and never used, which is how a rotation whose Set-Cookie never reached the
  // browser is told apart from a stolen token: both leave the browser holding
  // the retired parent, but only theft leaves a successor that someone went on
  // to use. Stamped once, on first resolve.
  firstUsedAt DateTime? @map("first_used_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@index([familyId])
  @@map("sessions")
}
