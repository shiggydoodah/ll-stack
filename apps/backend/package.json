{
  "name": "@repo/backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "node --watch --enable-source-maps -r ts-node/register -r ./scripts/ts-node-resolve-js-ext.cjs src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "smoke:dist": "node scripts/dist-boot-guard.mjs",
    "smoke:tsnode": "node --enable-source-maps -r ts-node/register -r ./scripts/ts-node-resolve-js-ext.cjs scripts/tsnode-boot-guard.cjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node ../../scripts/jest-open-handle-guard.mjs --config ./jest.config.cjs",
    "openapi:extract": "node --enable-source-maps -r ts-node/register -r ./scripts/ts-node-resolve-js-ext.cjs scripts/extract-openapi.ts",
    "seed": "node --enable-source-maps -r ts-node/register -r ./scripts/ts-node-resolve-js-ext.cjs scripts/seed.ts",
    "db:reset": "DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@localhost:5433/llstack_dev} sh -c 'prisma migrate reset --force && prisma db seed'",
    "prisma:generate": "prisma generate",
    "prisma:lint": "prisma-lint --config ../../.prismalintrc.yml prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:both": "DATABASE_URL=postgresql://postgres:postgres@localhost:5433/llstack_dev prisma migrate deploy && DATABASE_URL=postgresql://postgres:postgres@localhost:5433/llstack_test prisma migrate deploy",
    "//clean": "`*.tsbuildinfo` matters: the shared nestjs preset sets `incremental`, so removing dist/ without it leaves tsc believing the output is current and the next build silently emits nothing.",
    "clean": "rm -rf dist .turbo coverage *.tsbuildinfo"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/schedule": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/throttler": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/exporter-metrics-otlp-http": "catalog:",
    "@opentelemetry/exporter-trace-otlp-http": "catalog:",
    "@opentelemetry/instrumentation-express": "catalog:",
    "@opentelemetry/instrumentation-http": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@opentelemetry/sdk-node": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@prisma/instrumentation": "catalog:",
    "@repo/logging": "workspace:*",
    "@repo/schema": "workspace:*",
    "@repo/utils": "workspace:*",
    "argon2": "^0.45.1",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "cookie-parser": "^1.4.7",
    "helmet": "catalog:",
    "nestjs-pino": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "pino-pretty": "catalog:",
    "prisma": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "uuid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "catalog:",
    "@repo/config": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "^24.13.3",
    "@types/pg": "catalog:",
    "@types/supertest": "catalog:",
    "@typescript/native": "catalog:",
    "jest": "catalog:",
    "supertest": "catalog:",
    "ts-jest": "catalog:",
    "ts-node": "^10.9.2",
    "typescript": "catalog:"
  }
}
