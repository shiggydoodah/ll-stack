# App
# REQUIRED — there is no default. Every fail-closed check in `env.schema.ts`
# (dev-credential refusal, secret length floor, argon2 cost floors, rate
# limiting, FRONTEND_ORIGIN) keys off this value, so an omitted NODE_ENV would
# silently disarm all of them. The backend refuses to boot without it.
NODE_ENV=development
PORT=3100

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/llstack_dev

# API secret — required header on every request (presented by the frontend/admin BFF servers).
# The value below is the shared LOCAL DEV default and must stay byte-identical to
# apps/frontend/.env.example and apps/testing/.env.test.example — a mismatch makes every BFF call 401 and reads in the
# UI as a failed request. `env.schema.ts` requires a non-empty value, so an empty default
# here would stop a fresh clone booting at all. Replace it outside local dev — a
# staging/production boot on this exact value is refused by `env.schema.ts`, as is
# any replacement shorter than 32 characters. Generate: openssl rand -base64 24
BACKEND_API_SECRET=dev-backend-api-secret

# Admin API secret — required header on admin-only routes (used by local-machine
# admin tooling) and on `/docs*` when the OpenAPI docs are enabled in a deployed
# environment. Local dev default; also required non-empty by `env.schema.ts`,
# which likewise refuses this value — and anything under 32 characters — in
# staging/production. Generate: openssl rand -base64 24
ADMIN_API_KEY=dev-admin-api-key

# Sessions
# AUTH_SESSION_TTL_SECONDS=604800    # 7 days; drives sessions.expires_at and the cookie maxAge
# Expired sessions are deleted on an interval (auth/session-prune.service.ts).
# Defaults to on everywhere but test.
# AUTH_SESSION_PRUNE_ENABLED=true
# AUTH_SESSION_PRUNE_INTERVAL_MS=3600000
# AUTH_SESSION_PRUNE_BATCH_SIZE=500

# OpenAPI docs (/docs, /docs-json, /docs-yaml). Defaults to ON in development and
# OFF everywhere else: the document describes every route, DTO, and error shape,
# and Swagger mounts it outside the guard/throttler/access-log pipeline. Setting
# this true in staging/production puts the whole `/docs*` tree behind ADMIN_API_KEY
# (x-admin-key header, or HTTP Basic with the key as the password).
# OPENAPI_DOCS_ENABLED=false

# Rate-limit / reverse-proxy topology
# Express `trust proxy`. Behind a proxy/LB, set this DELIBERATELY so req.ip is the
# real client IP (otherwise every client shares one throttle bucket). Over-trusting
# lets clients spoof X-Forwarded-For — only trust as many hops as you actually run.
#   unset/false = trust nobody (safe default) | <n> = trust n hops (e.g. 1) | true = trust all (discouraged) | loopback / <subnet>
# TRUST_PROXY=1
# Declared backend instance count. Throttling is in-memory, so staging/production
# refuses to boot with more than one instance until a shared store (e.g. Redis) exists.
# BACKEND_INSTANCE_COUNT=1

# Logging
APPLICATION_NAME=backend
# LOG_SINK=stdout              # stdout (default) | http_otlp | seq
# LOG_LEVEL=info               # trace | debug | info | warn | error | fatal — defaults: development=debug, staging=info, production=info, test=warn
# LOG_PRETTY=false             # true enables pino-pretty (development only)
# LOG_REDACT_PATHS=            # comma-separated paths to redact; prefix with + to append to defaults

# Seq (used when LOG_SINK=seq)
# SEQ_SERVER_URL=http://localhost:5342
# SEQ_API_KEY=

# HTTP OTLP (used when LOG_SINK=http_otlp)
# LOG_HTTP_OTLP_ENDPOINT=
# LOG_HTTP_TIMEOUT_MS=5000
# LOG_HTTP_BATCH_SIZE=100
# LOG_HTTP_QUEUE_SIZE=1000
# LOG_HTTP_FLUSH_INTERVAL_MS=5000
# LOG_HTTP_MAX_RETRIES=3
# LOG_HTTP_BACKOFF_BASE_MS=200
# LOG_HTTP_BACKOFF_MAX_MS=10000
# LOG_HTTP_BACKOFF_JITTER_FACTOR=0.3
# LOG_HTTP_FAILURE_FALLBACK_THRESHOLD=5
# LOG_HTTP_INIT_FAILURE_FALLBACK_THRESHOLD=3
# LOG_HTTP_CIRCUIT_OPEN_MS=30000
# LOG_HTTP_SHUTDOWN_DRAIN_TIMEOUT_MS=10000

# Slow query logging
# LOG_SLOW_QUERY_THRESHOLD_MS=500

# OpenTelemetry (backend-only; off by default — tests/local stay off)
# Traces: when enabled, the traces OTLP endpoint is required.
# OTEL_TRACES_ENABLED=false
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_TRACES_SAMPLE_RATE=           # [0,1]; defaults: 1 dev/test, 0.1 staging/production
# OTEL_SERVICE_NAME=                 # defaults to APPLICATION_NAME
# Metrics: when omitted, OTEL_METRICS_ENABLED mirrors OTEL_TRACES_ENABLED and the
# metrics endpoint is derived from the traces endpoint (/v1/traces → /v1/metrics).
# NOTE: Seq (the local dev sink) ingests OTLP logs + traces but NOT metrics — point
# the metrics endpoint at an OTel collector/Prometheus-compatible backend.
# OTEL_METRICS_ENABLED=false
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics

# The frontend's public URL and the browser Origin allowlist. Defaulted to the
# local frontend in development/test; required in staging/production.
FRONTEND_PUBLIC_URL=http://localhost:4100
# FRONTEND_ORIGIN=http://localhost:4100
