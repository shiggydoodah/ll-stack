{
  "name": "eightbit",
  "defaultMode": "light",
  "palette": {
    "ink": "#16112b",
    "cream": "#f2ecd9",
    "tan": "#d8cfae",
    "orange": "#e8703a",
    "green": "#67c463",
    "cyan": "#66d9e8",
    "red": "#e04f39",
    "yellow": "#e8c53a",
    "lavender": "#9d8cff",
    "pink": "#e864a8",
    "panel-dark": "#211c33",
    "well-dark": "#262040"
  },
  "modes": {
    "light": {
      "background": "cream",
      "foreground": "ink",
      "accent": "orange",
      "backgroundSubtle": "color-mix(in oklab, {cream} 95%, {ink})",
      "backgroundMuted": "tan",
      "border": "ink",
      "borderStrong": "ink",
      "borderHover": "ink",
      "borderInvalid": "red",
      "textSubtle": "color-mix(in oklab, {ink} 70%, {cream})",
      "inputBackground": "color-mix(in oklab, {cream} 93%, {ink})",
      "inputBackgroundFocus": "cream",
      "focusRing": "cyan",
      "focusRingBackground": "cream",
      "tones": {
        "red": { "base": "red", "contrast": "cream" },
        "green": { "base": "green", "contrast": "ink" },
        "amber": { "base": "yellow", "contrast": "ink" },
        "blue": { "base": "cyan", "contrast": "ink" },
        "purple": { "base": "lavender", "contrast": "ink" },
        "magenta": { "base": "pink", "contrast": "ink" }
      }
    },
    "dark": {
      "background": "color-mix(in oklab, {ink} 92%, black)",
      "foreground": "cream",
      "accent": "orange",
      "backgroundSubtle": "panel-dark",
      "backgroundMuted": "well-dark",
      "border": "black",
      "borderStrong": "black",
      "borderHover": "color-mix(in oklab, {ink} 40%, black)",
      "borderInvalid": "red",
      "inputBackground": "well-dark",
      "inputBackgroundFocus": "color-mix(in oklab, {well-dark} 92%, {cream})",
      "focusRing": "cyan",
      "focusRingBackground": "panel-dark",
      "tones": {
        "red": { "base": "red", "contrast": "cream" },
        "green": { "base": "green", "contrast": "ink" },
        "amber": { "base": "yellow", "contrast": "ink" },
        "blue": { "base": "cyan", "contrast": "ink" },
        "purple": { "base": "lavender", "contrast": "ink" },
        "magenta": { "base": "pink", "contrast": "ink" }
      },
      "shadows": {
        "sm": "3px 3px 0 0 black",
        "md": "4px 4px 0 0 black",
        "lg": "6px 6px 0 0 black"
      }
    }
  },
  "fonts": {
    "body": {
      "family": "VT323",
      "fallbacks": ["monospace"],
      "files": [{ "path": "fonts/VT323-Regular.woff2", "weight": "400" }]
    },
    "display": {
      "family": "Press Start 2P",
      "fallbacks": ["monospace"],
      "files": [{ "path": "fonts/PressStart2P-Regular.woff2", "weight": "400" }]
    },
    "mono": { "alias": "body" }
  },
  "radius": { "sm": "0px", "md": "0px", "lg": "0px" },
  "shadows": {
    "sm": "3px 3px 0 0 {ink}",
    "md": "4px 4px 0 0 {ink}",
    "lg": "6px 6px 0 0 {ink}"
  },
  "border": { "width": "3px", "style": "solid" },
  "motion": { "fast": "0ms", "slow": "120ms", "easing": "steps(2, end)" },
  "display": { "case": "uppercase", "tracking": "0.06em" },
  "custom": "custom.css"
}
