{
  "name": "@repo/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./components": "./src/ui/components/index.ts",
    "./hooks": "./src/ui/hooks/index.ts",
    "./icons": "./src/ui/icons/index.ts",
    "./integrations": "./src/ui/integrations/index.ts",
    "./primitives": "./src/ui/primitives/index.ts",
    "./providers": "./src/ui/providers/index.ts",
    "./types": "./src/types/index.ts",
    "./specimens": "./src/specimens/index.ts",
    "./styles.css": "./src/styles.css",
    "./theme": "./src/theme/index.ts",
    "./themes/*": "./themes/*/index.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "themes:build": "tsx scripts/generate-themes.ts",
    "verify": "pnpm run lint && pnpm run typecheck && tsx scripts/generate-themes.ts --check && node ./scripts/verify-css-exports.mjs && node ./scripts/verify-component-catalog.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-hover-card": "1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tanstack/react-form": "^1.33.3",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "lucide-react": "^1.28.0",
    "react-easy-crop": "^6.2.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "jsdom": "^29.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.20.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4"
  }
