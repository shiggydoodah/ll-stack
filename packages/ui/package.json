{
  "name": "@repo/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./components": "./src/ui/components/index.ts",
    "./hooks": "./src/ui/hooks/index.ts",
    "./icons": "./src/ui/icons/index.ts",
    "./integrations": "./src/ui/integrations/index.ts",
    "./primitives": "./src/ui/primitives/index.ts",
    "./providers": "./src/ui/providers/index.ts",
    "./types": "./src/types/index.ts",
    "./specimens": "./src/specimens/index.ts",
    "./styles.css": "./src/styles.css",
    "./theme": "./src/theme/index.ts",
    "./themes/*": "./themes/*/index.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "themes:build": "tsx scripts/generate-themes.ts",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && tsx scripts/generate-themes.ts --check && node ./scripts/verify-css-exports.mjs && node ./scripts/verify-component-catalog.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "catalog:",
    "@radix-ui/react-dialog": "catalog:",
    "@radix-ui/react-hover-card": "catalog:",
    "@radix-ui/react-popover": "catalog:",
    "@radix-ui/react-scroll-area": "catalog:",
    "@radix-ui/react-slider": "catalog:",
    "@radix-ui/react-slot": "catalog:",
    "@radix-ui/react-tabs": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-table": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "cmdk": "catalog:",
    "lucide-react": "catalog:",
    "react-easy-crop": "catalog:",
    "sonner": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "vaul": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "^24.13.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsx": "^4.20.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
