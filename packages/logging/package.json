{
  "name": "@repo/logging",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.js",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./shared": {
      "types": "./src/shared.ts",
      "require": "./dist/shared.js",
      "import": "./src/shared.ts",
      "default": "./src/shared.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && echo '{\"type\":\"commonjs\"}' > dist/package.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/node": "^26.1.1",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
